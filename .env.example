# 이 파일을 복사해 .env 를 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있습니다. 절대 커밋하지 마세요.

# ── 필수 ─────────────────────────────────────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# ── Django ───────────────────────────────────────
# 운영에서는 반드시 설정 (미설정 시 DEBUG=False면 기동 실패)
# 생성: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# 로컬 개발에서만 True
DJANGO_DEBUG=True

# 쉼표 구분. 운영 예: learningpath.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS / CSRF ──────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── 선택 ─────────────────────────────────────────
# 미설정 시 SQLite 사용
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# 사용할 Claude 모델 (미설정 시 claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5
